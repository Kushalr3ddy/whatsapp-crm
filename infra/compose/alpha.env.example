# Copy to infra/compose/.env (git-ignored) and fill every blank. Generate each secret with:
#   openssl rand -hex 32
#
# ENCRYPTION_KEY: losing it makes every stored message and every linked WhatsApp number
# permanently unreadable. Back it up somewhere OTHER than the database backup.
APP_SECRET=
API_KEY=
ENCRYPTION_KEY=
ENCRYPTION_INDEX_KEY=
POSTGRES_PASSWORD=

# Where people reach it. Only used for links; change it once there is a real address.
PUBLIC_URL=http://localhost:3001

# The number's local timezone, NOT the server's (docs/08-antiban.md).
SEND_TIMEZONE=Asia/Kolkata

# Optional: host ports, if the defaults are taken.
# API_HOST_PORT=3000
# WEB_HOST_PORT=3001
# POSTGRES_HOST_PORT=5434
