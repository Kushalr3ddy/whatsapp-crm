# Copy to infra/compose/.env ON THE SERVER and fill in. Never commit the real file (it is git-ignored).
# Secrets (APP_SECRET, API_KEY, ENCRYPTION_KEY, ENCRYPTION_INDEX_KEY) are generated on first start and kept in the `state`
# volume; leave them blank. After the first start copy /app/state/secrets.env somewhere safe: without it the database is unreadable.

# What people type in the browser (no domain yet: the server's IP with dashes + .sslip.io).
SITE_ADDRESS=139-162-10-20.sslip.io
PUBLIC_URL=https://139-162-10-20.sslip.io

# Only Caddy may reach these two (Docker publishes ports around the firewall otherwise).
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# A real password: the default is not a secret.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# First-run admin and organisation (used once, on an empty install; the password is printed in `docker compose logs app`).
ADMIN_EMAIL=you@example.com
ORG_NAME=Hiring Studios
ORG_SLUG=hiring-studios

# A line across the top of every page.
ENVIRONMENT_BANNER=Beta test: expect bugs, tell us what you find

SEND_TIMEZONE=Asia/Kolkata
