# ─── Required in every deployment ────────────────────────────────────────────────────
# A missing value here is a hard crash at boot with a readable message, never a silent
# fallback (docs/00-prior-art.md, M17). This file is the companion to the Zod schema in
# packages/shared/src/config.ts — the schema is what actually validates.

# Postgres. Works against the bundled container, a local server, or a managed provider
# (Supabase, Aiven, Neon, RDS) — it is only ever a connection string (docs/18-providers.md).
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_crm

# Signing key for sessions and tokens. Generate with: openssl rand -hex 32
APP_SECRET=

# The externally reachable base URL. Used for webhook callbacks and links in messages.
PUBLIC_URL=https://crm.example.com
# Optional line shown across the top of every page of the web app. Use it on a test or staging server so
# nobody mistakes it for the real thing. Empty = no banner.
ENVIRONMENT_BANNER=

# Encryption at rest. Two SEPARATE 32-byte hex keys, both required.
#   openssl rand -hex 32
# ENCRYPTION_KEY encrypts message bodies and WhatsApp session credentials.
# ENCRYPTION_INDEX_KEY is the deterministic blind-index key that makes an encrypted value
# searchable without decrypting the column. They must differ: reusing one key for both would
# leak which rows hold identical plaintexts.
# LOSING ENCRYPTION_KEY MEANS LOSING EVERY LINKED WHATSAPP NUMBER AND EVERY STORED MESSAGE.
# Back it up separately from the database — a dump and its key in one place is a single
# point of compromise.
ENCRYPTION_KEY=
ENCRYPTION_INDEX_KEY=

# The DEPLOYMENT BOOTSTRAP key. Send it as: Authorization: Bearer <this value>
#   openssl rand -hex 32
# It can do exactly two things: create an organisation, and mint that org's first API key.
# It is REFUSED on every data route — no messages, no contacts, no senders. Day-to-day access
# uses per-org keys from the api_key table (npm run admin -- key) or a signed-in session.
API_KEY=

# ─── Runtime ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | test | production
PORT=3000
HOST=0.0.0.0
# Browser origins allowed to call the API from another host/port, comma-separated, exact form
# (http://192.168.1.20:4000). Server-to-server callers (e.g. JobPortal's backend) need nothing here.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info                # trace | debug | info | warn | error | fatal
PROCESS_ROLE=all              # all | api | worker | gateway   ("all" is the lean default)

# ─── Drivers (docs/18-providers.md) ──────────────────────────────────────────────────
# Every default is the free, self-hostable option, so an otherwise-empty file still boots.
PRESET=lean                   # lean | standard | scale
STORAGE_DRIVER=filesystem     # filesystem (default) | minio | s3
STORAGE_PATH=./storage        # filesystem driver only; gitignored
# S3-compatible storage: only read when STORAGE_DRIVER is s3 or minio, and then all of BUCKET and both KEYs
# are required (a missing one stops the app at boot). Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# Switching an install that already has local files to S3 does NOT copy them over; they stay on disk and
# stop being found. Copy them first (a migration job is not built yet; docs/21-deferred.md D-63).
# S3_BUCKET=
# S3_ENDPOINT=                # leave unset for AWS S3; set for R2, B2 or MinIO (e.g. http://minio:9000)
# S3_REGION=auto              # R2: auto. AWS / B2: the real region
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=        # unset = true for minio, false for s3
QUEUE_DRIVER=pgboss           # pgboss (inside Postgres, no extra service) | bullmq (needs Redis)
TELEMETRY_DRIVER=none         # none | prometheus | otlp   — off by default, costs ~1-2GB RAM
LLM_DRIVER=none               # none | ollama | openai | anthropic | gemini
SMS_DRIVER=none               # none | twilio | msg91

# ─── Messaging safety (docs/08-antiban.md) ───────────────────────────────────────────
# Defaults, not ceilings. The hard limits the engine enforces cannot be raised to an
# unsafe value by anyone, including an admin.
DEFAULT_COUNTRY=IN
SEND_RATE_PER_MINUTE=8
SEND_RATE_PER_DAY=1500
# Circadian pacing: shape WHEN a number sends across the day, not only how much. SEND_TIMEZONE is
# the number's local day (any IANA zone); overnight, sends defer to the morning. SEND_CIRCADIAN=false
# turns the day/night curve off and leaves the rate ceilings above unchanged.
#
# ⚠️  SEND_TIMEZONE is NOT read from the server's clock or cloud region. It is this explicit value.
#     If you move the deployment to a cloud region in a different timezone — or the number serves a
#     different region than before — you MUST set this to the number's actual local timezone, or the
#     "quiet overnight" window will land on the wrong hours (e.g. it will go silent during the local
#     working day and blast at local 3 a.m.).
SEND_TIMEZONE=Asia/Kolkata
SEND_CIRCADIAN=true
# Contact-graph gates: a send to someone who has replied goes at full speed; a stranger waits
# longer, and a number may only START this many brand-new stranger conversations per hour / day.
# Cold-blasting a fresh list is a top ban signal; these cap it. CONTACT_GRAPH_GATES=false turns
# the relationship gate off (rate ceilings and circadian pacing still apply).
NEW_CONTACTS_PER_HOUR=5
NEW_CONTACTS_PER_DAY=20
# The daily cap above is only earned once ~30% of the last week's new contacts have replied (min 10
# of them, 48 h to answer); until then 5/day. false = always the flat cap.
NEW_CONTACT_REPLY_FLOOR=true
CONTACT_GRAPH_GATES=true

# Number fallback: for a contact with more than one phone number, ask WhatsApp (once, cached) whether the
# primary one has an account before the first message, and use the next one that does. Never done for a
# contact with a single number, and never in bulk. false = always message the primary number.
SEND_VERIFY_FALLBACK_NUMBERS=true

# Recipient timezone: also respect the recipient's day, inferred from their phone number's
# country (never the server's location). Only ever slows or defers a send. false = off.
SEND_RECIPIENT_TIMEZONE=true

# Read behaviour: blue-tick inbound messages only after a 10-60 min human-like delay, in active
# hours. false = the gateway sends no read receipts at all.
SEND_READ_RECEIPTS=true

# Background entropy: every 2-6 h per connected number, in active hours, an abandoned "typing..."
# and a brief online blip, so an idle number is not machine-shaped. false = none.
SEND_BACKGROUND_ENTROPY=true

# Typing simulation: show the "typing…" bubble and pause a beat proportional to the message length
# before each send, so a send looks human rather than instant (an instant send is a bot tell).
# Cosmetic anti-ban. SEND_TYPING_SIMULATION=false turns it off (sends go out without the beat).
SEND_TYPING_SIMULATION=true

# Body-variation backstop: the most identical message bodies one number may queue within a rolling
# 24h. Beyond it, further identical-body recipients wait. Only bites a no-variation blast — spintax
# ({Hi|Hey}) and {{name}} make each body differ, so it never fires on a varied campaign.
IDENTICAL_BODY_DAILY_CAP=50

# Which transport the gateway drives. `baileys` is the real thing. `fake` is an in-memory channel
# for CI and local UI tests (it connects senders whose provider is 'fake' and sends nothing real);
# the app refuses to boot with `fake` when NODE_ENV=production.
GATEWAY_CHANNEL=baileys

# Seconds between the gateway's safety-net sweeps (campaign dispatch + result reconciliation). Leave at
# 60 for real numbers; a test run can set it to 3 so a broadcast completes quickly.
GATEWAY_SWEEP_SECONDS=60

# ─── Inbox UI (apps/web) ─────────────────────────────────────────────────────────────
# Where the UI finds the API.
CRM_API_URL=http://localhost:3000

# The UI needs NO key of its own. It forwards the signed-in person's session to the API, so
# the API authorises that person by their role rather than seeing one shared identity. Sign in
# at /login with an account from `npm run admin -- org` or `npm run admin -- user`.

# Live headed walkthrough (`npm run test:live`): the operator's own phones, E.164. Real WhatsApp messages
# are sent to exactly these. LIVE_SEND_TO gets the one-to-one test; LIVE_BROADCAST_TO is a comma list.
# LIVE_OVERRIDE_GATES=1 re-runs inside the 14-day cooldown; LIVE_SLOWMO=0 speeds the browser up.
LIVE_SEND_TO=
LIVE_BROADCAST_TO=
