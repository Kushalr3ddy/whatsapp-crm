# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
*.tsbuildinfo
# Regenerated by Next on every dev/build, and it references files inside .next/,
# so committing it would break a fresh clone's typecheck.
apps/web/next-env.d.ts

# environment & secrets — never commit these
.env
.env.*
!.env.example
config/preset.local.yml
*.pem
*.key

# runtime state
uploads/
storage/
logs/
*.log

# local data volumes
data/
pgdata/

# test & coverage
coverage/
.vitest/
playwright-report/
test-results/

# editor / OS
.DS_Store
.idea/
*.swp
