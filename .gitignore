# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
*.tsbuildinfo
# Regenerated by Next on every dev/build, and it references files inside .next/,
# so committing it would break a fresh clone's typecheck.
apps/web/next-env.d.ts

# environment & secrets — never commit these
.env
.env.*
!.env.example
# Backups people actually make. `.env.*` does not match a name like `.og_env`, and one
# `git add -A` would publish ENCRYPTION_KEY — which is the one secret with no recovery.
.og_env
*env.bak
*.env.backup
.env.local
.env.orig
config/preset.local.yml
*.pem
*.key

# runtime state
uploads/
storage/
logs/
*.log

# local data volumes
data/
pgdata/

# test & coverage
coverage/
.vitest/
playwright-report/
test-results/

# editor / OS
.DS_Store
.idea/
*.swp
