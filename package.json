{
  "name": "whatsapp-crm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Generic, self-hostable WhatsApp CRM. See docs/ for the design.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/channels/*",
    "packages/providers/*",
    "apps/*"
  ],
  "scripts": {
    "//1": "─── everyday ─────────────────────────────────────────────────────────",
    "dev": "tsx watch --env-file-if-exists=.env apps/api/src/server.ts",
    "dev:all": "bash infra/scripts/dev-up.sh",
    "gateway": "tsx watch --env-file-if-exists=.env apps/gateway/src/main.ts",
    "web": "NEXT_TELEMETRY_DISABLED=1 node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web --port 3001",
    "web:build": "NEXT_TELEMETRY_DISABLED=1 npm --workspace @crm/web run build",
    "start": "node apps/api/dist/server.js",
    "docs:pdf": "node scripts/docs-pdf.mjs",
    "db:docs": "tsx --env-file-if-exists=.env scripts/db-docs.ts",
    "check": "npm run typecheck && npm run typecheck:web && npm run lint && npm run test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "vitest run --config vitest.sim.config.ts",
    "test:e2e": "playwright test",
    "verify": "bash scripts/verify.sh",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:roles": "playwright test tests/e2e/zz-roles-flow.spec.ts",
    "test:roles:live": "ROLES_LIVE=1 playwright test tests/e2e/zz-roles-flow.spec.ts --headed",
    "//2": "─── database: db:setup does everything a new clone needs ────────────",
    "db:setup": "npm run db:dev:up && npm run db:migrate:all",
    "db:dev:up": "bash infra/scripts/dev-db.sh up",
    "db:dev:down": "bash infra/scripts/dev-db.sh down",
    "db:dev:status": "bash infra/scripts/dev-db.sh status",
    "db:dev:reset": "bash infra/scripts/dev-db.sh reset",
    "db:psql": "bash infra/scripts/dev-db.sh psql",
    "db:sql": "bash infra/scripts/dev-db.sh sql",
    "db:query": "bash infra/scripts/dev-db.sh query",
    "db:rls-demo": "bash infra/scripts/dev-db.sh sql infra/scripts/rls-demo.sql",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:test",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:migrate:test": "DATABASE_URL=postgresql://dev:dev@localhost:5434/whatsapp_crm_test tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=packages/db/drizzle.config.ts",
    "//3": "─── whatsapp: link a real number and send on it (docs/20-orientation.md) ───",
    "wa:link": "tsx --env-file-if-exists=.env scripts/wa-link.ts",
    "wa:send": "tsx --env-file-if-exists=.env scripts/wa-link.ts send",
    "//4": "─── administration: provisioning and support (scripts/admin.ts) ───",
    "admin": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "keys": "tsx --env-file-if-exists=.env scripts/keys.ts",
    "//5": "─── local testing only: sign in → broadcast → send, on a fake number (scripts/local-flow.ts) ───",
    "local:flow": "tsx --env-file-if-exists=.env scripts/local-flow.ts",
    "//6": "─── UI-test seed: a fake connected number, people, tags, conversations (scripts/local-seed.ts) ───",
    "local:seed": "tsx --env-file-if-exists=.env scripts/local-seed.ts",
    "//7": "─── alpha container: API + gateway + web + Postgres (infra/compose/README.md) ───",
    "alpha:up": "bash infra/scripts/compose.sh up -d --build",
    "alpha:tunnel": "bash infra/scripts/compose.sh --profile tunnel up -d --build",
    "alpha:down": "bash infra/scripts/compose.sh --profile tunnel down",
    "alpha:logs": "bash infra/scripts/compose.sh logs -f app"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@node-rs/argon2": "^2.2.1",
    "baileys": "6.7.24",
    "drizzle-orm": "^0.36.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.11.15",
    "pino": "^9.5.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.5",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.16.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "marked": "^18.0.14",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8"
  }
}
