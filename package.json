{
  "name": "whatsapp-crm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Generic, self-hostable WhatsApp CRM. See docs/ for the design.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/channels/*",
    "packages/providers/*",
    "apps/*"
  ],
  "scripts": {
    "//": "--- everyday ---",
    "dev": "tsx watch --env-file-if-exists=.env apps/api/src/server.ts",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "//db": "--- database ---",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:studio": "drizzle-kit studio --config=packages/db/drizzle.config.ts",
    "db:dev:up": "bash infra/scripts/dev-db.sh up",
    "db:dev:down": "bash infra/scripts/dev-db.sh down",
    "//wa": "--- dev tool: link and test a real whatsapp number (see docs/20-orientation.md) ---",
    "wa:link": "tsx --env-file-if-exists=.env scripts/wa-link.ts",
    "wa:send": "tsx --env-file-if-exists=.env scripts/wa-link.ts send",
    "db:dev:reset": "bash infra/scripts/dev-db.sh reset",
    "db:dev:status": "bash infra/scripts/dev-db.sh status",
    "db:psql": "bash infra/scripts/dev-db.sh psql",
    "db:migrate:test": "DATABASE_URL=postgresql://dev:dev@localhost:5434/whatsapp_crm_test tsx --env-file-if-exists=.env packages/db/src/migrate.ts"
  },
  "dependencies": {
    "baileys": "6.7.24",
    "drizzle-orm": "^0.36.4",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.11.15",
    "pino": "^9.5.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.5",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.16.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8"
  }
}
