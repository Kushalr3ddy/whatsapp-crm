    },
    {
      "_id": "r_burst",
      "_type": "request",
      "parentId": "grp_p6",
      "modified": 0,
      "created": 0,
      "url": "{{ _.base_url }}/messages",
      "name": "queue a burst, then watch it drain slowly",
      "description": "Send this 10+ times quickly, then poll the thread.\n\nWITHOUT pacing every one would go at machine speed \u2014 which is how a number is lost permanently.\n\nWITH pacing you should see:\n  \u00b7 a 1.5-4s gap between each send (Gaussian, not a fixed interval)\n  \u00b7 no more than SEND_RATE_PER_MINUTE (default 8) in any minute\n  \u00b7 the rest sitting at status 'queued' \u2014 NOT failed\n\nA paced message is left queued on purpose: early is not wrong, and failing it would lose it. Watch the gateway log for 'send paced'.",
      "method": "POST",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ _.org_key }}"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "metaSortKey": 3,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"to\": \"{{ _.test_recipient }}\",\n  \"body\": \"burst test\"\n}"
      }
    },
