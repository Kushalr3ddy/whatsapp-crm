    {
      "_id": "grp_p6",
      "_type": "request_group",
      "parentId": "wrk_crm",
      "name": "5 \u00b7 Send pacing (P6) \u2014 READ THIS FIRST",
      "description": "These queue REAL messages. With the gateway running and a number linked they will be SENT to whoever test_recipient names. Use a number you control.\n\nThe gate is in the gateway, not the API, so the API always answers 202. What pacing changes is WHEN the gateway drains the queue \u2014 and whether it drains it at all.",
      "metaSortKey": -50,
      "environment": {},
      "modified": 0,
      "created": 0
    },
    {
      "_id": "r_send",
      "_type": "request",
      "parentId": "grp_p6",
      "modified": 0,
      "created": 0,
      "url": "{{ _.base_url }}/messages",
      "name": "queue one message \u2192 202",
      "description": "202 means ACCEPTED, not sent. The gateway decides when it actually goes.\n\nThen poll the thread: status goes queued \u2192 sent \u2192 delivered \u2192 read.",
      "method": "POST",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ _.org_key }}"
